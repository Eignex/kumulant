{
  "version": 1,
  "cases": [
    {"name": "a comparison binds a named reference", "type": "boolean",
     "expr": {"ge": [{"ref": "value"}, 0]}, "bindings": {"value": 3}, "integer": true, "binary64": true},
    {"name": "lt keeps operand order", "type": "boolean",
     "expr": {"lt": [{"ref": "a"}, {"ref": "b"}]}, "bindings": {"a": 2, "b": 3}, "integer": true, "binary64": true},
    {"name": "le includes equality", "type": "boolean",
     "expr": {"le": [{"ref": "a"}, {"ref": "b"}]}, "bindings": {"a": 3, "b": 3}, "integer": true, "binary64": true},
    {"name": "eq compares values", "type": "boolean",
     "expr": {"eq": [{"ref": "a"}, {"ref": "b"}]}, "bindings": {"a": 3, "b": 4}, "integer": false, "binary64": false},
    {"name": "gt keeps operand order", "type": "boolean",
     "expr": {"gt": [{"ref": "a"}, {"ref": "b"}]}, "bindings": {"a": 3, "b": 4}, "integer": false, "binary64": false},
    {"name": "add sums two operands", "type": "number",
     "expr": {"add": [{"ref": "a"}, 5]}, "bindings": {"a": -2}, "integer": 3, "binary64": 3},
    {"name": "mul multiplies two operands", "type": "number",
     "expr": {"mul": [{"ref": "a"}, {"ref": "b"}]}, "bindings": {"a": -3, "b": 4}, "integer": -12, "binary64": -12},
    {"name": "min selects the smaller operand", "type": "number",
     "expr": {"min": [{"ref": "a"}, {"ref": "b"}]}, "bindings": {"a": -3, "b": 4}, "integer": -3, "binary64": -3},
    {"name": "max selects the larger operand", "type": "number",
     "expr": {"max": [{"ref": "a"}, {"ref": "b"}]}, "bindings": {"a": -3, "b": 4}, "integer": 4, "binary64": 4},
    {"name": "abs takes a single bare operand", "type": "number",
     "expr": {"abs": {"ref": "a"}}, "bindings": {"a": -5}, "integer": 5, "binary64": 5},
    {"name": "pow raises to a nonnegative integer literal", "type": "number",
     "expr": {"pow": [{"ref": "a"}, 3]}, "bindings": {"a": -2}, "integer": -8, "binary64": -8},
    {"name": "pow of zero to zero is one", "type": "number",
     "expr": {"pow": [{"ref": "a"}, 0]}, "bindings": {"a": 0}, "integer": 1, "binary64": 1},
    {"name": "if is a condition then else triple", "type": "number",
     "expr": {"if": [{"gt": [{"ref": "a"}, 0]}, {"ref": "a"}, {"mul": [-1, {"ref": "a"}]}]},
     "bindings": {"a": -4}, "integer": 4, "binary64": 4},
    {"name": "and and not combine conditions", "type": "boolean",
     "expr": {"and": [{"ge": [{"ref": "a"}, 0]}, {"not": {"gt": [{"ref": "a"}, 9]}}]},
     "bindings": {"a": 4}, "integer": true, "binary64": true},
    {"name": "or combines conditions", "type": "boolean",
     "expr": {"or": [{"lt": [{"ref": "a"}, 0]}, {"gt": [{"ref": "a"}, 9]}]},
     "bindings": {"a": 4}, "integer": false, "binary64": false},
    {"name": "left grouping rounds the inner sum first", "type": "number",
     "expr": {"add": [{"add": [{"ref": "a"}, {"ref": "b"}]}, {"ref": "c"}]},
     "bindings": {"a": 10000000000000000, "b": 1, "c": 1}, "integer": "accept", "binary64": 10000000000000000},
    {"name": "right grouping keeps the exact small sum", "type": "number",
     "expr": {"add": [{"ref": "a"}, {"add": [{"ref": "b"}, {"ref": "c"}]}]},
     "bindings": {"a": 10000000000000000, "b": 1, "c": 1}, "integer": "accept", "binary64": 10000000000000002},
    {"name": "variadic add is an integer extension", "type": "number",
     "expr": {"add": [{"ref": "a"}, {"ref": "b"}, {"ref": "c"}]},
     "bindings": {"a": 1, "b": 2, "c": 3}, "integer": 6, "binary64": "reject"},
    {"name": "div is real division", "type": "number",
     "expr": {"div": [{"ref": "a"}, {"ref": "b"}]}, "bindings": {"a": 7, "b": 2}, "integer": "reject", "binary64": 3.5},
    {"name": "real division by zero is infinite", "type": "number",
     "expr": {"div": [{"ref": "a"}, {"ref": "b"}]}, "bindings": {"a": 1, "b": 0}, "integer": "reject",
     "binary64": "Infinity"},
    {"name": "real division of zero by zero is NaN", "type": "number",
     "expr": {"div": [{"ref": "a"}, {"ref": "b"}]}, "bindings": {"a": 0, "b": 0}, "integer": "reject",
     "binary64": "NaN"},
    {"name": "truncDiv truncates toward zero", "type": "number",
     "expr": {"truncDiv": [{"ref": "a"}, {"ref": "b"}]}, "bindings": {"a": -7, "b": 2}, "integer": -3,
     "binary64": "reject"},
    {"name": "truncMod takes the sign of the dividend", "type": "number",
     "expr": {"truncMod": [{"ref": "a"}, {"ref": "b"}]}, "bindings": {"a": -7, "b": 2}, "integer": -1,
     "binary64": "reject"},
    {"name": "truncDiv by zero has no value", "type": "number",
     "expr": {"truncDiv": [{"ref": "a"}, {"ref": "b"}]}, "bindings": {"a": 1, "b": 0}, "integer": "reject",
     "binary64": "reject"},
    {"name": "pow with a negative exponent is real", "type": "number",
     "expr": {"pow": [{"ref": "a"}, -1]}, "bindings": {"a": 2}, "integer": "reject", "binary64": 0.5},
    {"name": "pow with an expression exponent is real", "type": "number",
     "expr": {"pow": [{"ref": "a"}, {"ref": "b"}]}, "bindings": {"a": 2, "b": 3}, "integer": "reject", "binary64": 8},
    {"name": "pow with a fractional exponent is real", "type": "number",
     "expr": {"pow": [{"ref": "a"}, 0.5]}, "bindings": {"a": 4}, "integer": "reject", "binary64": 2},
    {"name": "a fractional literal is real", "type": "number",
     "expr": {"add": [{"ref": "a"}, 2.5]}, "bindings": {"a": 1}, "integer": "reject", "binary64": 3.5},
    {"name": "an integral literal with a fraction part is real and encodes as an integer", "type": "number",
     "expr": {"add": [{"ref": "a"}, 2.0]}, "bindings": {"a": 1}, "integer": "reject", "binary64": 3,
     "canonical": {"add": [{"ref": "a"}, 2]}},
    {"name": "an integral exponent literal encodes as an integer", "type": "number",
     "expr": {"add": [{"ref": "a"}, 1e2]}, "bindings": {"a": 1}, "integer": 101, "binary64": 101,
     "canonical": {"add": [{"ref": "a"}, 100]}},
    {"name": "an integer literal outside 32 bits is real", "type": "number",
     "expr": {"add": [{"ref": "a"}, 3000000000]}, "bindings": {"a": 1}, "integer": "reject", "binary64": 3000000001},
    {"name": "sub is a real extension", "type": "number",
     "expr": {"sub": [{"ref": "a"}, 1]}, "bindings": {"a": 2}, "integer": "reject", "binary64": 1},
    {"name": "an unbound reference is rejected", "type": "boolean",
     "expr": {"ge": [{"ref": "missing"}, 0]}, "bindings": {}, "integer": "reject", "binary64": "reject"},
    {"name": "a reference name must be a string", "type": "number",
     "expr": {"ref": 1}, "bindings": {}, "integer": "reject", "binary64": "reject"},
    {"name": "a string literal is rejected", "type": "number",
     "expr": {"add": [{"ref": "a"}, "2"]}, "bindings": {"a": 1}, "integer": "reject", "binary64": "reject"},
    {"name": "a keyed literal is rejected", "type": "number",
     "expr": {"const": 1}, "bindings": {}, "integer": "reject", "binary64": "reject"},
    {"name": "null is rejected", "type": "number",
     "expr": null, "bindings": {}, "integer": "reject", "binary64": "reject"},
    {"name": "a node holds exactly one operator", "type": "number",
     "expr": {"add": [{"ref": "a"}, 1], "mul": [{"ref": "a"}, 2]}, "bindings": {"a": 1}, "integer": "reject",
     "binary64": "reject"},
    {"name": "an unknown operator is rejected", "type": "number",
     "expr": {"bogus": [{"ref": "a"}, 1]}, "bindings": {"a": 1}, "integer": "reject", "binary64": "reject"},
    {"name": "a comparison needs two operands", "type": "boolean",
     "expr": {"ge": [{"ref": "a"}]}, "bindings": {"a": 1}, "integer": "reject", "binary64": "reject"},
    {"name": "operands are positional rather than named", "type": "boolean",
     "expr": {"ge": {"left": {"ref": "a"}, "right": 0}}, "bindings": {"a": 1}, "integer": "reject",
     "binary64": "reject"},
    {"name": "mul takes exactly two operands", "type": "number",
     "expr": {"mul": [{"ref": "a"}, {"ref": "a"}, {"ref": "a"}]}, "bindings": {"a": 1}, "integer": "reject",
     "binary64": "reject"},
    {"name": "if needs a condition and both branches", "type": "number",
     "expr": {"if": [{"gt": [{"ref": "a"}, 0]}, 1]}, "bindings": {"a": 1}, "integer": "reject", "binary64": "reject"},
    {"name": "if branches are positional rather than named", "type": "number",
     "expr": {"if": {"cond": {"gt": [{"ref": "a"}, 0]}, "then": 1, "otherwise": 0}}, "bindings": {"a": 1},
     "integer": "reject", "binary64": "reject"},
    {"name": "a unary operand is not wrapped in an array", "type": "number",
     "expr": {"abs": [{"ref": "a"}]}, "bindings": {"a": 1}, "integer": "reject", "binary64": "reject"},
    {"name": "a condition is not a number", "type": "number",
     "expr": {"add": [{"ge": [{"ref": "a"}, 0]}, 1]}, "bindings": {"a": 1}, "integer": "reject", "binary64": "reject"}
  ]
}
