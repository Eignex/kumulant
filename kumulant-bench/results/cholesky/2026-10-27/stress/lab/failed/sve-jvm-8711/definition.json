{
  "name": "cholesky-stress-2048-sve-jvm",
  "repository": "Eignex/kumulant",
  "description": "Order-2048 Cholesky stress and scaling study with unblocked order-32 controls: numerical/ownership preflight, then allocating and workspace factors, solves and GP evaluations. Seed 139, noise 1e-6, jitter 1e-10; fitting rounds stay at order 512. Not a before/after comparison. arm64 SVE pool without SVE2. JVM scalar then SIMD in one case, 512 MiB heap, standard JMH warmup/measurement with two forks and GC profiler.",
  "base": {
    "ref": "ca3200444c0c7db9dc7fdcd35c84d797b8862c78",
    "timeout": "5400000"
  },
  "nodeTags": {
    "require": [
      "arch:arm64",
      "simd:sve"
    ],
    "exclude": [
      "local",
      "simd:sve2"
    ]
  },
  "profile": {
    "main": "com.eignex.kumulant.bench.CholeskyLabProfileKt",
    "buildTasks": [
      ":kumulant-bench:prepareBenchmark"
    ],
    "classpath": [
      "kumulant-bench/build/classes/kotlin/jvm/main",
      "kumulant/build/classes/kotlin/jvm/main",
      "kumulant-bench/build/benchmarks/jvm/jars/kumulant-bench-jvm-jmh-JMH.jar"
    ],
    "args": [
      "--stress-order=2048",
      "--filter",
      ".*Cholesky(FactorBenchmark\\.(factor|factorWithWorkspace)|SolveBenchmark\\.(solveMatrix|solveMatrixInto)|WorkloadBenchmark\\.(covarianceConstruction|factorSolveLogDeterminant|factorSolveLogDeterminantWithWorkspace))$",
      "-p",
      "matrixCase=precision:32,rbf:512,rbf:1024,rbf:2048,matern:2048",
      "-p",
      "shape=32x1,1024x256,2048x1,2048x256",
      "-p",
      "historySize=512,2048"
    ]
  },
  "parallel": 1
}
