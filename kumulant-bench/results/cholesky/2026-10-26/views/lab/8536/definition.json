{
  "name": "cholesky-139-views-copy-jvm-small",
  "repository": "Eignex/kumulant",
  "description": "Matched order-32 control for the small blocked Cholesky view path; same published dependency, fixtures, warmup, forks and resource budget",
  "base": {
    "ref": "e0260626fa71deb78a97c3b42196811f70146e4e",
    "timeout": "7200000"
  },
  "nodeTags": {
    "require": [
      "arch:x86_64",
      "simd:avx2"
    ],
    "exclude": []
  },
  "profile": {
    "main": "com.eignex.kumulant.bench.CholeskyLabProfileKt",
    "buildTasks": [
      ":kumulant-bench:prepareBenchmark"
    ],
    "classpath": [
      "kumulant-bench/build/classes/kotlin/jvm/main",
      "kumulant/build/classes/kotlin/jvm/main",
      "kumulant-bench/build/benchmarks/jvm/jars/kumulant-bench-jvm-jmh-JMH.jar"
    ],
    "args": [
      "--filter",
      ".*CholeskyFactorBenchmark\\.(factor|factorWithWorkspace)$",
      "-p",
      "matrixCase=precision:32"
    ]
  },
  "parallel": 1
}
