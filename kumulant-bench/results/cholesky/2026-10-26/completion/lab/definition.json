{
  "name": "cholesky-139-native-completion",
  "repository": "Eignex/kumulant",
  "description": "Final production Native Cholesky: shared numerical preflight and actual backend receipts; two ordinary release-process repetitions at an unblocked control and a blocked RBF factor. Supplemental validation, not a before/after timing comparison.",
  "base": {
    "ref": "d40dff58654151034b6bf2a9ffe544baa8ffca3e",
    "timeout": "3600000"
  },
  "nodeTags": {
    "require": [
      "arch:x86_64",
      "simd:avx2"
    ],
    "exclude": []
  },
  "profile": {
    "main": "com.eignex.kumulant.bench.CholeskyLabProfileKt",
    "buildTasks": [
      ":kumulant-bench:prepareBenchmark",
      ":kumulant-bench:linkCholeskyQualityReleaseExecutableLinuxX64",
      ":kumulant-bench:linkLinuxX64BenchmarkReleaseExecutableLinuxX64"
    ],
    "classpath": [
      "kumulant-bench/build/classes/kotlin/jvm/main",
      "kumulant/build/classes/kotlin/jvm/main",
      "kumulant-bench/build/benchmarks/jvm/jars/kumulant-bench-jvm-jmh-JMH.jar"
    ],
    "args": [
      "--native-prepared",
      "-Pbench.filter=.*CholeskyFactorBenchmark\\.(factor|factorWithWorkspace)$",
      "-Pbench.param.matrixCase=precision:32,rbf:512"
    ]
  },
  "parallel": 1
}
